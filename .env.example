
# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=coach
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=coachapp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Auto-built by backend; override only if needed.
DATABASE_URL=postgresql+psycopg://coach:changeme_dev_only@db:5432/coachapp

# ── Backend ───────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── LLM ───────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint (Ollama, OpenAI, NVIDIA NIM, OpenRouter, Together.ai).
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-YOUR_KEY_HERE
LLM_MODEL=deepseek-ai/deepseek-v4-flash
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=0.6
# Context window, for adaptive context packing.
LLM_CONTEXT_TOKENS=131072
# LLM_* above = "local" pool. LLM_FALLBACK_* = "cloud" pool; switch between
# them via the UI sidebar toggle. Set LLM_FALLBACK_MODEL="" for no cloud pool.
# Each tier defaults to the previous tier's BASE_URL/API_KEY if left blank.
LLM_FALLBACK_MODEL=meta/llama-3.3-70b-instruct
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
# Second cloud tier, tried only if LLM_FALLBACK_MODEL fails. "" to disable.
LLM_FALLBACK2_MODEL=
LLM_FALLBACK2_BASE_URL=
LLM_FALLBACK2_API_KEY=
# Retries for transient provider errors (capacity/rate-limit), with backoff.
LLM_MAX_TRANSIENT_RETRIES=4
# Max concurrent LLM requests; keep under the provider's limit (NIM = 32).
LLM_MAX_CONCURRENCY=8

# ── Garmin Connect ────────────────────────────────────────────────────
# Unofficial `garminconnect` login. Keep this file private.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Sync intervals (minutes) / windows (days) / hour.
GARMIN_RECENT_SYNC_MINUTES=15
GARMIN_RECENT_SYNC_DAYS=2
GARMIN_FULL_SYNC_HOUR=3
GARMIN_FULL_SYNC_DAYS=30

# ── USDA / Nutrition MCP ──────────────────────────────────────────────
# Free key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=DEMO_KEY
# USDA MCP server path in the backend container; default is fine for Docker.
USDA_MCP_SCRIPT=/opt/usda-api-mcp/main.py

# ── Athlete ───────────────────────────────────────────────────────────
# IANA timezone used for "today" everywhere.
ATHLETE_TIMEZONE=Europe/Berlin
# Weekly schedule, Monday first. One of: rest, gym, fencing, double, competition.
WEEKLY_SCHEDULE=fencing,gym,fencing,gym,fencing,fencing,rest
# Hour (local) the morning brief is generated.
MORNING_BRIEF_HOUR=7

# ── Observability (Logfire) ───────────────────────────────────────────
# Optional Pydantic Logfire tracing token.
LOGFIRE_TOKEN=

# ── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
