# ──────────────────────────────────────────────────────────────────────
# FencingCoach AI — environment configuration
# Copy to `.env` and fill in. Never commit `.env`.
# ──────────────────────────────────────────────────────────────────────

# ── Postgres ──────────────────────────────────────────────────────────
POSTGRES_USER=coach
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_DB=coachapp
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Constructed automatically by backend, override only if needed
DATABASE_URL=postgresql+psycopg://coach:changeme_dev_only@db:5432/coachapp

# ── Backend ───────────────────────────────────────────────────────────
# Single-user app, no auth — reachable only via Tailscale.
BACKEND_CORS_ORIGINS=http://localhost:3000

# ── LLM ───────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Examples:
#   Local Ollama:   http://llm:11434/v1
#   OpenAI:         https://api.openai.com/v1
#   NVIDIA NIM:     https://integrate.api.nvidia.com/v1
#   OpenRouter:     https://openrouter.ai/api/v1
#   Together.ai:    https://api.together.xyz/v1
# DeepSeek V4 Flash is a reasoning model; thinking mode is enabled in the
# model factory (deps.py) via chat_template_kwargs, not here.
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-YOUR_KEY_HERE
LLM_MODEL=deepseek-ai/deepseek-v4-flash
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=0.6
# Approx context window for adaptive context packing
LLM_CONTEXT_TOKENS=131072
# Secondary model/provider tried whenever the primary fails with a
# transient error (capacity/rate-limit, or fully unreachable — e.g. a
# local model server that's offline). Set LLM_FALLBACK_MODEL="" to disable.
# Defaults to the primary's LLM_BASE_URL/LLM_API_KEY if the two vars below
# are left blank; set them to point the fallback at a different provider
# entirely, e.g. primary = your own machine running llama.cpp/vLLM,
# fallback = a hosted cloud endpoint that's always available.
LLM_FALLBACK_MODEL=meta/llama-3.3-70b-instruct
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
# Transparent retries for transient provider capacity/rate-limit errors
# (e.g. NIM "ResourceExhausted: Worker local total request limit reached"),
# with exponential backoff. Bump if you see those errors surface to users.
LLM_MAX_TRANSIENT_RETRIES=4
# Max concurrent in-flight LLM requests this process makes. Keep well under
# the provider's per-worker concurrency limit (NIM = 32) to avoid capacity
# errors. Lower it further if you still hit them (e.g. set to 1 if
# LLM_BASE_URL is a local llama.cpp server started with --parallel 1).
LLM_MAX_CONCURRENCY=8

# ── Garmin Connect ────────────────────────────────────────────────────
# Uses the unofficial `garminconnect` library (email + password login).
# Stored encrypted-at-rest is out of scope for Phase 1; keep this file private.
GARMIN_EMAIL=
GARMIN_PASSWORD=
# Sync intervals (minutes)
GARMIN_RECENT_SYNC_MINUTES=15
GARMIN_RECENT_SYNC_DAYS=2                   # recurring recent-sync backfill window
GARMIN_FULL_SYNC_HOUR=3                     # nightly full sync at 03:00 local
GARMIN_FULL_SYNC_DAYS=30                    # nightly full-sync backfill window

# ── USDA / Nutrition MCP ──────────────────────────────────────────────
# USDA FoodData Central API key (get free at https://fdc.nal.usda.gov/api-key-signup)
# Used directly by services/usda.py AND passed through to the local USDA
# MCP subprocess (rpassafaro/usda-api-mcp) below.
USDA_API_KEY=DEMO_KEY
# Path to the USDA MCP server script inside the backend container (cloned
# by the Dockerfile at build time). Only relevant if running the backend
# outside Docker without cloning https://github.com/rpassafaro/usda-api-mcp
# yourself — leave as the default for the normal docker-compose setup.
USDA_MCP_SCRIPT=/opt/usda-api-mcp/main.py

# ── Athlete ───────────────────────────────────────────────────────────
# IANA timezone used for "today" everywhere (readiness/targets/training/etc.)
ATHLETE_TIMEZONE=Europe/Berlin
# Default weekly training day-type schedule, Monday first. Single source
# of truth for day-type detection + gym-session templating — see
# app/services/schedule.py. One of: rest, gym, fencing, double, competition.
WEEKLY_SCHEDULE=fencing,gym,fencing,gym,fencing,fencing,rest
# Hour (athlete-local time) the auto morning brief worker generates today's
# brief so it's ready before you check the dashboard.
MORNING_BRIEF_HOUR=7

# ── Observability (Logfire) ───────────────────────────────────────────
# Optional: Pydantic Logfire token for tracing PydanticAI agents + MCP
LOGFIRE_TOKEN=

# ── Frontend ──────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
